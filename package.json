{
  "name": "solarlayout-desktop-docs",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "SolarLayout Desktop product documentation — Next.js + Fumadocs",
  "scripts": {
    "dev": "next dev --port 3007 --webpack",
    "build": "next build --webpack",
    "start": "next start --port 3007",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,mdx}\"",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "screenshots:index": "node scripts/build-screenshot-index.mjs",
    "screenshots:index:bess": "node scripts/build-bess-screenshot-index.mjs",
    "videos:index": "node scripts/build-video-index.mjs",
    "videos:index:bess": "node scripts/build-bess-video-index.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "fumadocs-core": "^16.8.10",
    "fumadocs-mdx": "^15.0.4",
    "fumadocs-ui": "^16.8.10",
    "image-size": "^2.0.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "^16.1.6",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "exceljs": "^4.4.0",
    "globals": "^17.2.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  }
}
